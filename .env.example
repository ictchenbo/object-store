# 中文注释：复制为 .env 后必须修改全部密码与 API Key。
# scripts/start.sh 会拒绝弱值（change-me / dev-key / minioadmin / 空值）；
# 本地快速调试可 ALLOW_INSECURE=1 跳过检查，生产环境 ENVIRONMENT=prod 会在启动时直接失败。

ENVIRONMENT=dev

# PostgreSQL
POSTGRES_PASSWORD=change-me-postgres

# MinIO：ROOT 仅用于 minio-init 建用户；应用（API/Worker）只使用 APP 账号
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_APP_USER=minio-app
MINIO_APP_PASSWORD=change-me-minio-app

# 客户端直传 MinIO 时使用的可达地址（非部署机访问时必须改为外部可达地址）
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=objects

# API Key → 租户/操作者；值可为字符串（仅租户）或 {"tenant_id":"...","actor_id":"..."}
API_KEYS_JSON={"change-me-api-key":"demo"}

# TLS：默认关闭。启用前运行 scripts/gen-certs.sh 生成自签证书（certs/）
TLS_ENABLED=false
FORCE_HTTPS=false
MINIO_SECURE=false
PUBLIC_BASE_URL=http://localhost:18000

# 可选：对账告警 webhook（留空则只写日志与 var/reports/*.jsonl）
# ALERT_WEBHOOK_URL=
